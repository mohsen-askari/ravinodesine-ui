# Copy to .env.local for local development, or set these in the process environment of the server.
# Nothing here is a real value. Never commit secrets and never prefix them with NEXT_PUBLIC_.

# static (default): the built-in dataset, no backend needed.   api: content from the Ravino backend.
CONTENT_SOURCE=static

# --- only when CONTENT_SOURCE=api -------------------------------------------------------------
# Backend origin (no path). Read on the server only, at build time and at run time.
RAVINO_API_URL=https://admin.example.com
# Origin that serves the images, if it is not the backend (CDN, bucket). Defaults to RAVINO_API_URL.
#RAVINO_MEDIA_URL=https://media.example.com
# Shared secret of the content webhook: 32+ random bytes, identical to the backend's FRONTEND_REVALIDATE_SECRET.
# Generate one with:  php -r "echo bin2hex(random_bytes(32));"
RAVINO_REVALIDATE_SECRET=
# Only while rotating the secret: the old value, still accepted.
#RAVINO_REVALIDATE_SECRET_PREVIOUS=
# Accepted clock difference of the webhook timestamp, in seconds (1-3600).
#RAVINO_REVALIDATE_TOLERANCE_SECONDS=300

# Canonical / sitemap base URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- development only -------------------------------------------------------------------------
# Lets the image optimizer fetch from a backend on localhost/a private address. NEVER in production.
#RAVINO_ALLOW_LOCAL_MEDIA=true
